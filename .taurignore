# Ignore frontend source files (handled by Vite HMR)
# Use explicit paths to avoid matching src-tauri/src/
src/**/*.tsx
src/**/*.ts
src/**/*.jsx
src/**/*.js
src/**/*.css

# Ignore build outputs
dist/
node_modules/

# Ignore config files at root
vite.config.ts
tailwind.config.js
tsconfig.json
package-lock.json

# Ignore version files (prevent reload on version bump from git hooks)
src-tauri/tauri.conf.json
